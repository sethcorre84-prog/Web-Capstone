[debug] [2026-10-09T06:37:57.114Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/peakpath-ccd4a/rulesets {"name":"projects/peakpath-ccd4a/rulesets/7bf1af6d-7e69-4620-820f-1d2b038740db","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // ===================================================================\r\n    // Helpers\r\n    // ===================================================================\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return signedIn()\r\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\r\n    }\r\n\r\n    /* Timed suspensions -------------------------------------------------\r\n       User Management > Suspend User writes status \"Suspended\" and a\r\n       suspendedUntil timestamp onto the hiker's users record. The app\r\n       checks the same two fields and refuses to open the account, but that\r\n       is a client doing as it is told: an old build, or a request made\r\n       straight to the API, would ignore it. This is the part that cannot\r\n       be talked around.\r\n\r\n       request.time is the SERVER clock, so a device with its date wound\r\n       forward gains nothing. No suspendedUntil means the suspension runs\r\n       until an admin lifts it.\r\n\r\n       Cost: one extra document read on each request this guards.\r\n\r\n       Deliberately NOT applied to locations, emergency or sos_alerts. A\r\n       suspended hiker in trouble must still be able to raise an SOS and\r\n       stay visible on the map. Suspension is an account penalty, not a\r\n       safety one.\r\n       ------------------------------------------------------------------- */\r\n    /* Every field is read with get() and a default. Reading a field that\r\n       is not on the document -- record.status when the record has no\r\n       status at all -- is an ERROR in this language, not false, and an\r\n       error inside a condition denies the request. Accounts created by the\r\n       app have no status field (AuthService.signUp does not write one), so\r\n       the direct form denied every hiker who had never been suspended:\r\n       joining a team and filing a hazard report both failed with \"Missing\r\n       or insufficient permissions\". */\r\n    function suspensionActive(record) {\r\n      return record.get('status', '') is string\r\n        && record.get('status', '').lower() == 'suspended'\r\n        && (\r\n          record.get('suspendedUntil', null) == null\r\n          || record.get('suspendedUntil', null) > request.time\r\n        );\r\n    }\r\n\r\n    function isSuspended() {\r\n      return signedIn()\r\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid))\r\n        && suspensionActive(\r\n             get(/databases/$(database)/documents/users/$(request.auth.uid)).data\r\n           );\r\n    }\r\n\r\n    function notSuspended() {\r\n      return !isSuspended();\r\n    }\r\n\r\n    function changedKeys() {\r\n      return request.resource.data.diff(resource.data).affectedKeys();\r\n    }\r\n\r\n    // ===================================================================\r\n    // Accounts\r\n    // ===================================================================\r\n    function emailVerifiedForNewUser() {\r\n      let email = request.resource.data.get('email', '');\r\n      let path = /databases/$(database)/documents/emailVerifications/$(string(email).lower());\r\n      return email is string\r\n        && exists(path)\r\n        && get(path).data.get('verified', false) == true\r\n        && get(path).data.verifiedUntil > request.time;\r\n    }\r\n\r\n    match /users/{userId} {\r\n      allow read: if signedIn();\r\n\r\n      /* Sign-up writes role \"hiker\" (AuthService.signUp). Guides are made\r\n         by an admin promoting someone from the console, never by the\r\n         account itself, so a self-registration may only claim \"hiker\" --\r\n         otherwise a modified client could register straight as a guide and\r\n         the create/join split would mean nothing. Admins are unrestricted:\r\n         User Management creates accounts of either role. */\r\n      /* An admin-created profile (User Management > Add User) needs an\r\n         email that was verified by code first: the sendSignupVerification-\r\n         Code / confirmSignupVerificationCode Cloud Functions mark\r\n         emailVerifications/{email} verified for an hour. Without it the\r\n         profile is refused and the page removes the sign-in account it\r\n         had just made. Self-registration in the app is unaffected. */\r\n      allow create: if (isAdmin() && emailVerifiedForNewUser())\r\n        || (\r\n          signedIn()\r\n          && request.auth.uid == userId\r\n          && (\r\n            !('role' in request.resource.data)\r\n            || (\r\n              request.resource.data.role is string\r\n              // Case-insensitive: the app writes \"hiker\", the web console\r\n              // capitalises (\"Hiker\"), and getUserRole lowers before it\r\n              // compares. A casing difference must not reject a sign-up.\r\n              && request.resource.data.role.lower() == 'hiker'\r\n            )\r\n          )\r\n        );\r\n\r\n      /* CHANGED. A hiker may still edit their own profile, but no longer\r\n         their own status, role or suspension. Writing status \"Active\" from\r\n         the app would otherwise undo a suspension in a single request,\r\n         which made the whole feature decorative. Admins are unrestricted. */\r\n      allow update: if isAdmin()\r\n        || (\r\n          signedIn()\r\n          && request.auth.uid == userId\r\n          && !changedKeys().hasAny([\r\n               'status', 'role',\r\n               'suspendedUntil', 'suspendedAt', 'suspendedBy',\r\n               'suspensionDays', 'suspensionReason'\r\n             ])\r\n        );\r\n\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    /* CHANGED: an admin may also create the entry, for someone else. User\r\n       Management > Add User saves the new account's profile and username\r\n       as the signed-in admin (the users rule above only lets an account\r\n       create itself as a hiker), so without this Add User is refused. */\r\n    match /usernames/{username} {\r\n      allow get: if true;\r\n      allow list: if false;\r\n      allow create: if signedIn()\r\n                    && (request.resource.data.uid == request.auth.uid || isAdmin());\r\n      allow update: if signedIn()\r\n                    && request.auth.uid == resource.data.uid\r\n                    && request.resource.data.uid == resource.data.uid\r\n                    && request.resource.data.email == resource.data.email;\r\n      allow delete: if false;\r\n    }\r\n\r\n    match /admins/{userId} {\r\n      // Anyone may check whether one known UID is an admin: Forgot Password\r\n      // does this before sign-in. Listing every admin still needs sign-in.\r\n      allow get: if true;\r\n      allow list: if signedIn();\r\n      // Settings > Profile Information saves the admin's own name, username,\r\n      // phone number and gender. Nothing else, so no one can grant\r\n      // themselves a role or add another admin.\r\n      allow update: if signedIn()\r\n                    && request.auth.uid == userId\r\n                    && changedKeys().hasOnly(['name', 'username', 'phone', 'gender', 'updatedAt']);\r\n      allow create, delete: if false;\r\n    }\r\n\r\n    /* Admin sign-in addresses, one document per admin, id = the email in\r\n       lower case. The login page's Forgot Password checks an address here\r\n       before anyone is signed in, so a single document can be read by\r\n       anyone -- but the collection can never be listed, so the addresses\r\n       cannot be browsed. An admin can only write the entry for their own\r\n       sign-in email; the login page does this on every admin sign-in. */\r\n    match /adminEmails/{email} {\r\n      allow get: if true;\r\n      allow list: if false;\r\n      allow create, update: if isAdmin()\r\n                            && request.auth.token.email is string\r\n                            && email == request.auth.token.email.lower()\r\n                            && request.resource.data.uid == request.auth.uid;\r\n      allow delete: if false;\r\n    }\r\n\r\n    /* Forgot Password codes, one per admin UID. Only the Cloud Functions in\r\n       functions/index.js touch these, through the Admin SDK, which skips\r\n       these rules. No browser may read or write one, or the code would be\r\n       no secret. */\r\n    match /passwordResets/{uid} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    // ===================================================================\r\n    // Safety. Never gated by a suspension.\r\n    // ===================================================================\r\n    match /locations/{userId} {\r\n      // Readable by the owner, their teammates, admins (web Geomap), and\r\n      // anyone when the owner opted in with isPublic.\r\n      // get() with defaults for the same reason as suspensionActive: a doc\r\n      // left by an older build without isPublic would otherwise error and\r\n      // deny the read, quietly hiding that teammate from the map.\r\n      allow read: if signedIn() &&\r\n                     (request.auth.uid == userId ||\r\n                      request.auth.uid in resource.data.get('sharedWith', []) ||\r\n                      isAdmin() ||\r\n                      resource.data.get('isPublic', false) == true);\r\n      allow create, update: if signedIn()\r\n                            && request.auth.uid == userId\r\n                            && request.resource.data.sharedWith is list\r\n                            && request.resource.data.sharedWith.size() <= 100;\r\n      allow delete: if signedIn() && request.auth.uid == userId;\r\n    }\r\n\r\n    /* A hiker's check-in, one document per hiker (id = uid): checkedIn and\r\n       the lastSeenAt heartbeat the app refreshes every two minutes\r\n       (CheckInService in the app). The portal reads them all for the\r\n       \"on the mountain now\" count and User Management's Last Active; a\r\n       hiker reads and writes only their own. Not gated by a suspension,\r\n       like locations: a suspended hiker already on the mountain still has\r\n       to be counted. Same block as the app repo's firestore.rules. */\r\n    match /checkIns/{userId} {\r\n      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);\r\n      allow create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == userId);\r\n    }\r\n\r\n    match /emergency/{alertId} {\r\n      allow read: if signedIn();\r\n      allow create: if signedIn();\r\n      allow update, delete: if isAdmin();\r\n    }\r\n\r\n    // The app's SosService still writes here (lib/features/sos/sos_service.dart).\r\n    // Same shape as emergency; remove this block once the app writes to\r\n    // emergency instead, or SOS logging fails silently.\r\n    match /sos_alerts/{alertId} {\r\n      allow read: if signedIn();\r\n      allow create: if signedIn();\r\n      allow update, delete: if isAdmin();\r\n    }\r\n\r\n    // ===================================================================\r\n    // Hazard reports\r\n    // ===================================================================\r\n    match /reports/{reportId} {\r\n      allow read: if signedIn();\r\n\r\n      // CHANGED: a suspended hiker cannot file new reports.\r\n      allow create: if signedIn() && notSuspended();\r\n\r\n      allow update: if isAdmin() && (\r\n        /* Before it is resolved: the ordinary verify / reject / edit /\r\n           archive-a-rejected-report writes, plus the HR-, R- and A-\r\n           renumbering of the reports left behind.\r\n\r\n           CHANGED: resolutionDetails added. It holds the structured answers\r\n           behind the resolution narrative, and without it here the entire\r\n           resolve write was rejected, because hasOnly() fails on a single\r\n           unlisted key. */\r\n        (\r\n          resource.data.get('status', 'pending') != 'resolved'\r\n          && changedKeys().hasOnly([\r\n               'status', 'statusNote', 'updatedAt', 'reportId',\r\n               'archivedAt', 'archivedBy', 'unarchivedAt',\r\n               'resolvedAt', 'resolvedBy', 'resolutionNote', 'resolutionDetails',\r\n               'hazardType', 'riskLevel', 'location', 'trail',\r\n               'reportedBy', 'contact', 'description'\r\n             ])\r\n          && (\r\n            !('status' in changedKeys())\r\n            || request.resource.data.status in ['pending', 'verified', 'rejected', 'archived', 'resolved']\r\n          )\r\n        )\r\n        ||\r\n        /* CHANGED. Resolving stays final: a resolved report cannot be\r\n           reopened, reworded or re-resolved. The exceptions are filing:\r\n           archiving it into Settings > Archived Resolved Reports, and\r\n           unarchiving it back (unarchivedAt), plus the renumbering that\r\n           keeps both lists gap-free (report-ids.js): the report moving\r\n           takes the next RES- or AR- number, and the ones after it move up\r\n           one. Status and everything the hiker reads stay untouched, and a\r\n           new reportId must be a RES- or AR- number. */\r\n        (\r\n          resource.data.get('status', 'pending') == 'resolved'\r\n          && changedKeys().hasOnly(['archived', 'archivedAt', 'archivedBy', 'unarchivedAt', 'reportId'])\r\n          && (\r\n            !('reportId' in changedKeys())\r\n            || request.resource.data.reportId.matches('^(RES|AR)-[0-9]{4}-[0-9]+$')\r\n          )\r\n        )\r\n      );\r\n\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /reportedUser/{reportId} {\r\n      // CHANGED: a suspended hiker cannot report other users.\r\n      allow create: if signedIn() && notSuspended();\r\n      allow read, update, delete: if isAdmin();\r\n    }\r\n\r\n    // ===================================================================\r\n    // Trails, teams, reviews\r\n    // ===================================================================\r\n    match /trails/{trailId} {\r\n      allow read: if signedIn();\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    /* Stations along a trail: the checkpoints listed on a trail's page and\r\n       opened for their own detail screen (lib/features/trails/\r\n       station_service.dart). Reference data like trails -- hikers read,\r\n       only the web console writes. Without this block the stations section\r\n       is permanently empty, since every read is denied. */\r\n    match /stations/{stationId} {\r\n      allow read: if signedIn();\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    match /teams/{teamsId} {\r\n      allow read: if signedIn();\r\n      // CHANGED: a suspended hiker cannot create or join teams. Admins are\r\n      // exempt, since User Management edits membership with arrayUnion and\r\n      // arrayRemove on these documents.\r\n      allow create: if signedIn() && notSuspended();\r\n      allow update: if isAdmin() || (signedIn() && notSuspended());\r\n      allow delete: if signedIn() && request.auth.uid == resource.data.leaderID;\r\n    }\r\n\r\n    /* Trail reviews: a 1-5 star rating and optional comment, one per hiker\r\n       per trail. The document id is \"uid_trailID\", so authorship is tied to\r\n       the id itself rather than a field in the payload, which is what stops\r\n       someone writing a review as another user. */\r\n    match /reviews/{reviewId} {\r\n      allow read: if signedIn();\r\n      // CHANGED: a suspended hiker cannot post or edit reviews.\r\n      allow create, update: if signedIn()\r\n                            && notSuspended()\r\n                            && reviewId == request.auth.uid + '_' +\r\n                               request.resource.data.trailID\r\n                            && request.resource.data.userID == request.auth.uid\r\n                            && request.resource.data.stars is int\r\n                            && request.resource.data.stars >= 1\r\n                            && request.resource.data.stars <= 5\r\n                            && request.resource.data.comment.size() <= 300;\r\n      // The author can remove their own review; an admin can remove any.\r\n      allow delete: if signedIn()\r\n                    && (resource.data.userID == request.auth.uid || isAdmin());\r\n    }\r\n\r\n    match /Popularity/{PopularityId} {\r\n      allow read: if signedIn();\r\n      allow write: if false;\r\n    }\r\n\r\n    // ===================================================================\r\n    // Content and housekeeping\r\n    // ===================================================================\r\n    match /faqs/{faqId} {\r\n      function canManageFaqs() {\r\n        return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '')\r\n          in ['Super Administrator', 'Administrator'];\r\n      }\r\n      function validFaq() {\r\n        return request.resource.data.keys().hasOnly([\r\n            'question', 'answer', 'order', 'createdAt', 'updatedAt', 'updatedBy'\r\n          ])\r\n          && request.resource.data.question is string\r\n          && request.resource.data.question.size() > 0\r\n          && request.resource.data.question.size() <= 200\r\n          && request.resource.data.answer is string\r\n          && request.resource.data.answer.size() > 0\r\n          && request.resource.data.answer.size() <= 2000\r\n          && request.resource.data.order is int\r\n          && request.resource.data.order > 0\r\n          && request.resource.data.createdAt is timestamp\r\n          && request.resource.data.updatedAt is timestamp\r\n          && request.resource.data.updatedBy is string;\r\n      }\r\n      allow read: if signedIn();\r\n      allow create: if canManageFaqs() && validFaq()\r\n        && request.resource.data.createdAt == request.time\r\n        && request.resource.data.updatedAt == request.time\r\n        && request.resource.data.updatedBy == request.auth.uid;\r\n      allow update: if canManageFaqs() && validFaq()\r\n        && request.resource.data.createdAt == resource.data.createdAt\r\n        && (changedKeys().hasOnly(['order'])\r\n          || (request.resource.data.updatedAt == request.time\r\n            && request.resource.data.updatedBy == request.auth.uid));\r\n      allow delete: if canManageFaqs();\r\n    }\r\n\r\n    /* An expired advisory is read-only: past its expiry date, or marked\r\n       Expired (by End Advisory or the A&A page catching up on a lapsed\r\n       date). The writes still allowed are the ones that file it away:\r\n       stamping status \"Expired\", archiving it, and Settings' unarchive,\r\n       which returns it to Expired. The emailAdvisory Cloud Function uses\r\n       the Admin SDK and is not subject to these rules. */\r\n    function advisoryExpired() {\r\n      return resource.data.get('status', '') == 'Expired'\r\n        || (resource.data.get('expiresAt', null) is timestamp\r\n            && resource.data.expiresAt <= request.time);\r\n    }\r\n\r\n    match /Advisory/{advisoryId} {\r\n      allow read: if true;\r\n      allow create, delete: if isAdmin();\r\n      allow update: if isAdmin() && (\r\n        !advisoryExpired()\r\n        || (changedKeys().hasOnly(['status'])\r\n            && request.resource.data.status == 'Expired')\r\n        || (changedKeys().hasOnly(['status', 'archivedAt', 'archivedBy', 'visible', 'expiresAt'])\r\n            && request.resource.data.status == 'Archived')\r\n      );\r\n    }\r\n\r\n    match /notifications/{notificationId} {\r\n      allow read: if signedIn();\r\n      allow create: if signedIn();\r\n      allow write: if signedIn() && request.auth.uid == resource.data.createdBy;\r\n    }\r\n\r\n    match /counters/{counterId} {\r\n      allow get: if signedIn();\r\n      allow list: if false;\r\n      allow create: if signedIn()\r\n                    && request.resource.data.keys().hasOnly(['value'])\r\n                    && request.resource.data.value == 1;\r\n      allow update: if signedIn()\r\n                    && request.resource.data.keys().hasOnly(['value'])\r\n                    && request.resource.data.value == resource.data.value + 1;\r\n      allow delete: if false;\r\n    }\r\n\r\n    match /prescriptiveHistory/{day} {\r\n      allow read, write: if isAdmin();\r\n    }\r\n\r\n    // Email verification codes for Add User: written only by Cloud Functions.\r\n    match /emailVerifications/{email} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    match /passwordResetOtps/{username} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-09T06:37:57.782031Z","metadata":{"services":["cloud.firestore"]}}
