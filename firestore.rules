rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == adminId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Reports hikers file about other users. Any signed-in user may submit
    // one; only admins can read, act on, or delete them.
    match /reportedUser/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // One document per Manila date, written by analytics.html.
    match /prescriptiveHistory/{day} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
