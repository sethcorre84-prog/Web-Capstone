rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == adminId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Reports hikers file about other users. Any signed-in user may submit
    // one; only admins can read, act on, or delete them.
    match /reportedUser/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // One document per Manila date, written by analytics.html.
    match /prescriptiveHistory/{day} {
      allow read, write: if isAdmin();
    }

    // Live hiker positions written by the PeakPath app, one document per hiker
    // (locations/{uid}). Admins read them for the dashboard's Active Hikers
    // Today tile and the Geomap hiker layer; a hiker may only write their own.
    //
    // Read is owner-or-admin only. If the app also lets hikers see teammates
    // they have shared with (the `sharedWith` field the Geomap popup reads),
    // that needs its own condition — it is left out rather than guessed at,
    // because widening a read rule on location data is not reversible once
    // clients depend on it.
    match /locations/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
