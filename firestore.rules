rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================================================================
    // Helpers
    // ===================================================================
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /* Timed suspensions -------------------------------------------------
       User Management > Suspend User writes status "Suspended" and a
       suspendedUntil timestamp onto the hiker's users record. The app
       checks the same two fields and refuses to open the account, but that
       is a client doing as it is told: an old build, or a request made
       straight to the API, would ignore it. This is the part that cannot
       be talked around.

       request.time is the SERVER clock, so a device with its date wound
       forward gains nothing. No suspendedUntil means the suspension runs
       until an admin lifts it.

       Cost: one extra document read on each request this guards.

       Deliberately NOT applied to locations, emergency or sos_alerts. A
       suspended hiker in trouble must still be able to raise an SOS and
       stay visible on the map. Suspension is an account penalty, not a
       safety one.
       ------------------------------------------------------------------- */
    /* Every field is read with get() and a default. Reading a field that
       is not on the document -- record.status when the record has no
       status at all -- is an ERROR in this language, not false, and an
       error inside a condition denies the request. Accounts created by the
       app have no status field (AuthService.signUp does not write one), so
       the direct form denied every hiker who had never been suspended:
       joining a team and filing a hazard report both failed with "Missing
       or insufficient permissions". */
    function suspensionActive(record) {
      return record.get('status', '') is string
        && record.get('status', '').lower() == 'suspended'
        && (
          record.get('suspendedUntil', null) == null
          || record.get('suspendedUntil', null) > request.time
        );
    }

    function isSuspended() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && suspensionActive(
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data
           );
    }

    function notSuspended() {
      return !isSuspended();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ===================================================================
    // Accounts
    // ===================================================================
    match /users/{userId} {
      allow read: if signedIn();

      /* Sign-up writes role "hiker" (AuthService.signUp). Guides are made
         by an admin promoting someone from the console, never by the
         account itself, so a self-registration may only claim "hiker" --
         otherwise a modified client could register straight as a guide and
         the create/join split would mean nothing. Admins are unrestricted:
         User Management creates accounts of either role. */
      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && (
            !('role' in request.resource.data)
            || (
              request.resource.data.role is string
              // Case-insensitive: the app writes "hiker", the web console
              // capitalises ("Hiker"), and getUserRole lowers before it
              // compares. A casing difference must not reject a sign-up.
              && request.resource.data.role.lower() == 'hiker'
            )
          )
        );

      /* CHANGED. A hiker may still edit their own profile, but no longer
         their own status, role or suspension. Writing status "Active" from
         the app would otherwise undo a suspension in a single request,
         which made the whole feature decorative. Admins are unrestricted. */
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && !changedKeys().hasAny([
               'status', 'role',
               'suspendedUntil', 'suspendedAt', 'suspendedBy',
               'suspensionDays', 'suspensionReason'
             ])
        );

      allow delete: if isAdmin();
    }

    /* CHANGED: an admin may also create the entry, for someone else. User
       Management > Add User saves the new account's profile and username
       as the signed-in admin (the users rule above only lets an account
       create itself as a hiker), so without this Add User is refused. */
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
                    && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if signedIn()
                    && request.auth.uid == resource.data.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /admins/{userId} {
      // Anyone may check whether one known UID is an admin: Forgot Password
      // does this before sign-in. Listing every admin still needs sign-in.
      allow get: if true;
      allow list: if signedIn();
      // Settings > Profile Information saves the admin's own name, username,
      // phone number and gender. Nothing else, so no one can grant
      // themselves a role or add another admin.
      allow update: if signedIn()
                    && request.auth.uid == userId
                    && changedKeys().hasOnly(['name', 'username', 'phone', 'gender', 'updatedAt']);
      allow create, delete: if false;
    }

    /* Admin sign-in addresses, one document per admin, id = the email in
       lower case. The login page's Forgot Password checks an address here
       before anyone is signed in, so a single document can be read by
       anyone -- but the collection can never be listed, so the addresses
       cannot be browsed. An admin can only write the entry for their own
       sign-in email; the login page does this on every admin sign-in. */
    match /adminEmails/{email} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin()
                            && request.auth.token.email is string
                            && email == request.auth.token.email.lower()
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    /* Forgot Password codes, one per admin UID. Only the Cloud Functions in
       functions/index.js touch these, through the Admin SDK, which skips
       these rules. No browser may read or write one, or the code would be
       no secret. */
    match /passwordResets/{uid} {
      allow read, write: if false;
    }

    // ===================================================================
    // Safety. Never gated by a suspension.
    // ===================================================================
    match /locations/{userId} {
      // Readable by the owner, their teammates, admins (web Geomap), and
      // anyone when the owner opted in with isPublic.
      // get() with defaults for the same reason as suspensionActive: a doc
      // left by an older build without isPublic would otherwise error and
      // deny the read, quietly hiding that teammate from the map.
      allow read: if signedIn() &&
                     (request.auth.uid == userId ||
                      request.auth.uid in resource.data.get('sharedWith', []) ||
                      isAdmin() ||
                      resource.data.get('isPublic', false) == true);
      allow create, update: if signedIn()
                            && request.auth.uid == userId
                            && request.resource.data.sharedWith is list
                            && request.resource.data.sharedWith.size() <= 100;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /emergency/{alertId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // The app's SosService still writes here (lib/features/sos/sos_service.dart).
    // Same shape as emergency; remove this block once the app writes to
    // emergency instead, or SOS logging fails silently.
    match /sos_alerts/{alertId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ===================================================================
    // Hazard reports
    // ===================================================================
    match /reports/{reportId} {
      allow read: if signedIn();

      // CHANGED: a suspended hiker cannot file new reports.
      allow create: if signedIn() && notSuspended();

      allow update: if isAdmin() && (
        /* Before it is resolved: the ordinary verify / reject / edit /
           archive-a-rejected-report writes, plus the HR-, R- and A-
           renumbering of the reports left behind.

           CHANGED: resolutionDetails added. It holds the structured answers
           behind the resolution narrative, and without it here the entire
           resolve write was rejected, because hasOnly() fails on a single
           unlisted key. */
        (
          resource.data.get('status', 'pending') != 'resolved'
          && changedKeys().hasOnly([
               'status', 'statusNote', 'updatedAt', 'reportId',
               'archivedAt', 'archivedBy', 'unarchivedAt',
               'resolvedAt', 'resolvedBy', 'resolutionNote', 'resolutionDetails',
               'hazardType', 'riskLevel', 'location', 'trail',
               'reportedBy', 'contact', 'description'
             ])
          && (
            !('status' in changedKeys())
            || request.resource.data.status in ['pending', 'verified', 'rejected', 'archived', 'resolved']
          )
        )
        ||
        /* CHANGED. Resolving stays final: a resolved report cannot be
           reopened, reworded or re-resolved. The exceptions are filing:
           archiving it into Settings > Archived Resolved Reports, and
           unarchiving it back (unarchivedAt), plus the renumbering that
           keeps both lists gap-free (report-ids.js): the report moving
           takes the next RES- or AR- number, and the ones after it move up
           one. Status and everything the hiker reads stay untouched, and a
           new reportId must be a RES- or AR- number. */
        (
          resource.data.get('status', 'pending') == 'resolved'
          && changedKeys().hasOnly(['archived', 'archivedAt', 'archivedBy', 'unarchivedAt', 'reportId'])
          && (
            !('reportId' in changedKeys())
            || request.resource.data.reportId.matches('^(RES|AR)-[0-9]{4}-[0-9]+$')
          )
        )
      );

      allow delete: if isAdmin();
    }

    match /reportedUser/{reportId} {
      // CHANGED: a suspended hiker cannot report other users.
      allow create: if signedIn() && notSuspended();
      allow read, update, delete: if isAdmin();
    }

    // ===================================================================
    // Trails, teams, reviews
    // ===================================================================
    match /trails/{trailId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /* Stations along a trail: the checkpoints listed on a trail's page and
       opened for their own detail screen (lib/features/trails/
       station_service.dart). Reference data like trails -- hikers read,
       only the web console writes. Without this block the stations section
       is permanently empty, since every read is denied. */
    match /stations/{stationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teams/{teamsId} {
      allow read: if signedIn();
      // CHANGED: a suspended hiker cannot create or join teams. Admins are
      // exempt, since User Management edits membership with arrayUnion and
      // arrayRemove on these documents.
      allow create: if signedIn() && notSuspended();
      allow update: if isAdmin() || (signedIn() && notSuspended());
      allow delete: if signedIn() && request.auth.uid == resource.data.leaderID;
    }

    /* Trail reviews: a 1-5 star rating and optional comment, one per hiker
       per trail. The document id is "uid_trailID", so authorship is tied to
       the id itself rather than a field in the payload, which is what stops
       someone writing a review as another user. */
    match /reviews/{reviewId} {
      allow read: if signedIn();
      // CHANGED: a suspended hiker cannot post or edit reviews.
      allow create, update: if signedIn()
                            && notSuspended()
                            && reviewId == request.auth.uid + '_' +
                               request.resource.data.trailID
                            && request.resource.data.userID == request.auth.uid
                            && request.resource.data.stars is int
                            && request.resource.data.stars >= 1
                            && request.resource.data.stars <= 5
                            && request.resource.data.comment.size() <= 300;
      // The author can remove their own review; an admin can remove any.
      allow delete: if signedIn()
                    && (resource.data.userID == request.auth.uid || isAdmin());
    }

    match /Popularity/{PopularityId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ===================================================================
    // Content and housekeeping
    // ===================================================================
    match /Advisory/{advisoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow write: if signedIn() && request.auth.uid == resource.data.createdBy;
    }

    match /counters/{counterId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['value'])
                    && request.resource.data.value == 1;
      allow update: if signedIn()
                    && request.resource.data.keys().hasOnly(['value'])
                    && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    match /prescriptiveHistory/{day} {
      allow read, write: if isAdmin();
    }

    match /passwordResetOtps/{username} {
      allow read, write: if false;
    }
  }
}
