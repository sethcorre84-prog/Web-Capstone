
{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/htmlPages/landingPage",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/A&A",
      "destination": "/htmlPages/A&A.html"
    },
    {
      "source": "/analytics",
      "destination": "/htmlPages/analytics.html"
    },
    {
      "source": "/dashboard",
      "destination": "/htmlPages/dashboard.html"
    },
    {
      "source": "/emergency",
      "destination": "/htmlPages/emergency.html"
    },
    {
      "source": "/geomap",
      "destination": "/htmlPages/geomap.html"
    },
    {
      "source": "/hazardreport",
      "destination": "/htmlPages/hazardreport.html"
    },
    {
      "source": "/Home",
      "destination": "/htmlPages/Home.html"
    },
    {
      "source": "/landingPage",
      "destination": "/htmlPages/landingPage.html"
    },
    {
      "source": "/Setting",
      "destination": "/htmlPages/Setting.html"
    },
    {
      "source": "/trail",
      "destination": "/htmlPages/trail.html"
    },
    {
      "source": "/usermanagement",
      "destination": "/htmlPages/usermanagement.html"
    },
    {
      "source": "/userreports",
      "destination": "/htmlPages/userreports.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"PeakPath.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
