{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/htmlPages/landingPage", "permanent": false }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"PeakPath.apk\"" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
