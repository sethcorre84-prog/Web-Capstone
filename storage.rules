rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Same admin check as firestore.rules: the UID must have a document in
    // the Firestore "admins" collection.
    //
    // Reading Firestore from Storage rules needs a one-time grant: the
    // "Firebase Rules Firestore Service Agent" role for the Storage service
    // account. `firebase deploy --only storage` offers it ("Grant the new
    // role?") whenever the rules have changed; until it is granted, this
    // check fails and every upload is refused as unauthorized.
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Photos and videos attached to advisories/announcements (A&A.html).
    // The app shows them through the download URL saved on the advisory,
    // which works without needing read access here.
    match /advisories/{advisoryId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() && (
        (request.resource.contentType.matches('image/.*') &&
         request.resource.size <= 10 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/.*') &&
         request.resource.size <= 100 * 1024 * 1024)
      );
      allow delete: if isAdmin();
    }

    // Trail photos are shown by their saved download URL in Trail Management.
    match /trails/{trailId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Trail pictures matched to trails by file name (jsPages/trail-images.js),
    // e.g. trailPicture/sipitTrail.jpg for "Sipit Trail". Pages list this
    // folder, so signed-in users need read (which covers list) access.
    match /trailPicture/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Hiker badge pictures (01-trail-rookie.png ... 06-mountain-legend.png),
    // shown on the app's Home badge card and Profile. Uploaded by hand.
    match /badge/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Profile pictures hikers choose from on the app's Profile page. The
    // app lists this folder, so signed-in users need read (covers list).
    match /profileAvatar/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    /* Photos hikers attach in the PeakPath app, uploaded by
       ReportService._uploadReportPhoto as {folder}/{uid}/{timestamp}.jpg:
         reports/     hazard reports
         userReport/  Report User (optional photo of the reported user)
       Readable by any signed-in account (the portal shows them beside the
       report). Writable only into the uploader's own folder, images only,
       under 8 MB. A submitted photo is evidence, so the reporter can't
       replace or remove it; admins can, for takedowns. */
    match /reports/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }

    match /userReport/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }

    /* Photos on Community threads (lib/features/community/). Readable by
       any signed-in account; written only into the poster's own folder,
       images only, under 8 MB. The poster can delete theirs along with
       the post; admins can remove any. */
    match /communityPosts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());
    }

    /* A hiker's own profile photo (lib/features/profile/avatar_picker.dart,
       AvatarService.uploadOwn), shown everywhere by the download URL saved
       in users/{uid}.avatarUrl. Written only into the hiker's own folder,
       images only, under 5 MB; they can delete their old ones, and admins
       can remove any. */
    match /userAvatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
