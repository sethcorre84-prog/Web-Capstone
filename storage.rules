rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Same admin check as firestore.rules: the UID must have a document in
    // the Firestore "admins" collection.
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Photos and videos attached to advisories/announcements (A&A.html).
    // The app shows them through the download URL saved on the advisory,
    // which works without needing read access here.
    match /advisories/{advisoryId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() && (
        (request.resource.contentType.matches('image/.*') &&
         request.resource.size <= 10 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/.*') &&
         request.resource.size <= 100 * 1024 * 1024)
      );
      allow delete: if isAdmin();
    }

    // Trail photos are shown by their saved download URL in Trail Management.
    match /trails/{trailId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
